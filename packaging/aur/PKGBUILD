# Maintainer: Dan B <unknown@cryptoconspiracy.io>
pkgname=lili-crash
pkgver=0.5.0
pkgrel=1
pkgdesc="Find out why a program closed by itself: crash notifications with a one-click AI diagnosis"
arch=('any')
url="https://github.com/cryptoconspiracy/lili-crash"
license=('MIT')
depends=('python' 'systemd' 'libnotify' 'xdg-utils')
makedepends=('gettext')
optdepends=('plasma-workspace: the panel widget with AI usage and crash history'
            'libayatana-appindicator: the tray icon on desktops other than KDE Plasma'
            'python-gobject: the tray icon on desktops other than KDE Plasma'
            'konsole: a terminal for the diagnosis')
install=lili-crash.install
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('0365c483667d50dd1dc9313513813ec4fc7ecd278a65fb22616ff95be186f30c')

build() {
  cd "$pkgname-$pkgver"
  make locales
}

check() {
  cd "$pkgname-$pkgver"
  python3 -m py_compile bin/lili-crash
}

package() {
  cd "$pkgname-$pkgver"
  make PREFIX=/usr DESTDIR="$pkgdir" install
}
