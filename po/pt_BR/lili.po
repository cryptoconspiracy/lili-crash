msgid ""
msgstr ""
"Project-Id-Version: lili-crash\n"
"Report-Msgid-Bugs-To: \n"
"POT-Creation-Date: 2026-10-02 01:55-0300\n"
"PO-Revision-Date: 2026-09-25 12:00-0300\n"
