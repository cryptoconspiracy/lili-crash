"Plural-Forms: nplurals=2; plural=(n > 1);\n"

msgid "Choose a local .deb or .rpm file."
msgstr "Escolha um arquivo .deb ou .rpm local."

msgid "Choose a regular .deb or .rpm file."
msgstr "Escolha um arquivo comum .deb ou .rpm."

msgid "This file is not a recognized .deb or .rpm package."
msgstr "Este arquivo não é um pacote .deb ou .rpm reconhecido."

msgid "The package changed. Open it again to review the new file."
msgstr "O pacote foi alterado. Abra-o novamente para conferir o novo arquivo."

msgid "Lili Crash — Package detected"
msgstr "Lili Crash — Pacote detectado"

msgid "Install on this system"
msgstr "Instalar neste sistema"

msgid "Cancel"
msgstr "Cancelar"

msgid "The package window needs kdialog or zenity. Install one and open the file again."
msgstr "A janela de instalação precisa do kdialog ou zenity. Instale um deles e abra o arquivo novamente."

msgid "The package window could not open. Try again from your desktop session."
msgstr "Não foi possível abrir a janela de instalação. Tente novamente na sua sessão gráfica."

msgid "This installation assistant currently supports Arch Linux and its derivatives."
msgstr "Este assistente de instalação oferece suporte ao Arch Linux e seus derivados."

msgid "Lili's installation window needs PySide6. Install the pyside6 package and try again."
msgstr "A janela de instalação da Lili precisa do PySide6. Instale o pacote pyside6 e tente novamente."

msgid "Lili Crash — Install an application"
msgstr "Lili Crash — Instalar um aplicativo"

msgid "Lili flower logo"
msgstr "Logo da Lili em forma de flor"

msgid "Application installation"
msgstr "Instalação de aplicativos"

msgid "A package from another Linux."
msgstr "Um pacote de outro Linux."

#, python-brace-format
msgid "Lili can help you install it on {system}."
msgstr "A Lili pode ajudar você a instalá-lo no {system}."

msgid "DETECTED FORMAT"
msgstr "FORMATO ENCONTRADO"

msgid "YOUR SYSTEM"
msgstr "SEU SISTEMA"

#, python-brace-format
msgid "File: {path}\nSize: {size}\nSHA-256: {digest}"
msgstr "Arquivo: {path}\nTamanho: {size}\nSHA-256: {digest}"

msgid "Show file details"
msgstr "Ver detalhes do arquivo"

msgid "Hide file details"
msgstr "Ocultar detalhes do arquivo"

msgid "WHAT HAPPENS NEXT"
msgstr "O QUE A LILI VAI FAZER"

msgid "Check compatibility"
msgstr "Verificar a compatibilidade"

msgid "Check the application and the libraries it needs."
msgstr "Conferir o aplicativo e as bibliotecas necessárias."

msgid "Install for your system"
msgstr "Instalar no seu sistema"

msgid "Use a native package, tracked by pacman."
msgstr "Usar um pacote nativo, gerenciado pelo pacman."

msgid "Make it ready to use"
msgstr "Deixar tudo pronto para usar"

msgid "Set up icons and the application-menu shortcut."
msgstr "Configurar os ícones e o atalho no menu de aplicativos."

#, python-brace-format
msgid "Assistant: {agent}"
msgstr "Assistente: {agent}"

msgid "Your assistant opens in a terminal to check and install the app. If it cannot run here, it will explain why. Administrator authentication may be required."
msgstr "Seu assistente será aberto em um terminal para verificar e instalar o aplicativo. Se ele não puder rodar aqui, você saberá o motivo. Pode ser necessária autenticação de administrador."

msgid "Nothing is installed before you confirm."
msgstr "Nada será instalado antes da sua confirmação."

#, python-brace-format
msgid "Installing: {name}"
msgstr "Instalando: {name}"

#, python-brace-format
msgid "Could not register Lili as the package opener for {type}."
msgstr "Não foi possível registrar a Lili para abrir pacotes do tipo {type}."

msgid "packages: opening a .deb or .rpm now shows Lili's installation window"
msgstr "pacotes: abrir um .deb ou .rpm agora mostra a janela de instalação da Lili"

#, python-brace-format
msgid "No update error recorded for {id}"
msgstr "Nenhum erro de atualização registrado para {id}"

msgid "The package database is locked"
msgstr "O banco de dados de pacotes está bloqueado"

msgid "The updater reported an error"
msgstr "O atualizador informou um erro"

msgid "System update"
msgstr "Atualização do sistema"

msgid "System update reported an error"
msgstr "A atualização do sistema informou um erro"

#: bin/lili-crash:67
msgid "Touched memory it didn't own"
msgstr "Acessou memória que não era dele"

#: bin/lili-crash:68
msgid "Gave up on an internal error"
msgstr "Desistiu por um erro interno"

#: bin/lili-crash:69
msgid "Read memory that was no longer there"
msgstr "Leu memória que já não existia"

#: bin/lili-crash:70
msgid "Hit a math error, like dividing by zero"
msgstr "Errou uma conta, como dividir por zero"

#: bin/lili-crash:71
msgid "Tried to run an invalid instruction"
msgstr "Tentou executar uma instrução inválida"

#: bin/lili-crash:72
msgid "Stopped at a debugger trap"
msgstr "Parou num ponto de depuração"

#: bin/lili-crash:73
msgid "Made a forbidden system call"
msgstr "Fez uma chamada de sistema proibida"

#: bin/lili-crash:74
#, python-brace-format
msgid "Got signal {signal}"
msgstr "Recebeu o sinal {signal}"

#: bin/lili-crash:81
#, python-brace-format
msgid "today at {time}"
msgstr "hoje às {time}"

#: bin/lili-crash:83
#, python-brace-format
msgid "yesterday at {time}"
msgstr "ontem às {time}"

#: bin/lili-crash:85
#, python-brace-format
msgid "on {date} at {time}"
msgstr "em {date} às {time}"

#: bin/lili-crash:85
msgid "%m/%d"
msgstr "%d/%m"

#: bin/lili-crash:198
#, python-brace-format
msgid "The graphics driver ({driver}) stopped responding"
msgstr "O driver de vídeo ({driver}) parou de responder"

#: bin/lili-crash:199
msgid "The kernel crashed"
msgstr "O kernel quebrou"

#: bin/lili-crash:200
msgid "The kernel got stuck"
msgstr "O kernel ficou preso"

#: bin/lili-crash:201
msgid "It ran out of memory"
msgstr "A memória acabou"

#: bin/lili-crash:202
msgid "Nothing was logged before it stopped"
msgstr "Nada foi registrado antes de parar"

#: bin/lili-crash:375
#, python-brace-format
msgid "No early exit recorded for {id}"
msgstr "Nenhum fechamento precoce registrado para {id}"

#: bin/lili-crash:472
#, python-brace-format
msgid "No failed start recorded for {id}"
msgstr "Nenhuma abertura com erro registrada para {id}"

#: bin/lili-crash:483
msgid "Exited with an error as soon as it started"
msgstr "Saiu com erro assim que abriu"

#: bin/lili-crash:484
#, python-brace-format
msgid "Exited with an error {seconds} seconds after starting"
msgstr "Saiu com erro {seconds} segundos depois de abrir"

#: bin/lili-crash:496
#, python-brace-format
msgid "Unknown state: {state}. Use one of: {states}"
msgstr "Estado desconhecido: {state}. Use um destes: {states}"

#: bin/lili-crash:536 bin/lili-crash:615 bin/lili-crash:897
msgid "The computer froze"
msgstr "O computador travou"

#: bin/lili-crash:542
msgid "no log"
msgstr "sem registro"

#: bin/lili-crash:594
#, python-brace-format
msgid "Closed by itself {seconds} seconds after starting"
msgstr "Fechou sozinho {seconds} segundos depois de abrir"

#: bin/lili-crash:602
#, python-brace-format
msgid "No core dump with PID {pid}"
msgstr "Nenhum core dump com o PID {pid}"

#: bin/lili-crash:609
#, python-brace-format
msgid "No freeze recorded for boot {boot}"
msgstr "Nenhum travamento registrado no boot {boot}"

#: bin/lili-crash:616
#, python-brace-format
msgid "{reason}, {when}. It had to be forced off."
msgstr "{reason}, {when}. Foi preciso desligar na força."

#: bin/lili-crash:622
#, python-brace-format
msgid "{name} closed by itself"
msgstr "{name} fechou sozinho"

#: bin/lili-crash:623 bin/lili-crash:630
#, python-brace-format
msgid "{reason}, {when}."
msgstr "{reason}, {when}."

#: bin/lili-crash:625
#, python-brace-format
msgid "It ran with {tool}."
msgstr "Rodou com o {tool}."

#: bin/lili-crash:629
#, python-brace-format
msgid "{name} didn't open"
msgstr "{name} não abriu"

#: bin/lili-crash:637
#, python-brace-format
msgid "{name} crashed"
msgstr "{name} fechou sozinho"

#: bin/lili-crash:638
#, python-brace-format
msgid "{reason} ({signal}), {when}."
msgstr "{reason} ({signal}), {when}."

#: bin/lili-crash:643 bin/lili-crash:834
msgid "Find out why"
msgstr "Descobrir o porquê"

#: bin/lili-crash:778
msgid ""
"The tray icon needs AppIndicator: install gir1.2-ayatanaappindicator3-0.1 on "
"Debian and Ubuntu, libayatana-appindicator-gtk3 on Fedora, libayatana-"
"appindicator on Arch."
msgstr "O ícone da bandeja precisa do AppIndicator: instale gir1.2-ayatanaappindicator3-0.1 no Debian e no Ubuntu, libayatana-appindicator-gtk3 no Fedora, libayatana-appindicator no Arch."

#: bin/lili-crash:793
msgid "Something crashed"
msgstr "Algum programa travou"

#: bin/lili-crash:824
#, python-brace-format
msgid "Lili Crash: {count} new"
msgstr "Lili Crash: {count} novo(s)"

#: bin/lili-crash:824
msgid "Lili Crash: nothing new"
msgstr "Lili Crash: nada novo"

#: bin/lili-crash:827
#, python-brace-format
msgid "Find out why, all {count}"
msgstr "Descobrir o porquê, todos os {count}"

#: bin/lili-crash:835
msgid "Mark as resolved"
msgstr "Marcar como resolvido"

#: bin/lili-crash:837
msgid "Stop ignoring"
msgstr "Parar de ignorar"

#: bin/lili-crash:839
msgid "Ignore from now on"
msgstr "Ignorar daqui em diante"

#: bin/lili-crash:841
msgid "No crashes yet"
msgstr "Nenhum travamento ainda"

#: bin/lili-crash:844
msgid "Diagnose with"
msgstr "Diagnosticar com"

#: bin/lili-crash:857
#, python-brace-format
msgid "Install {agent}"
msgstr "Instalar {agent}"

#: bin/lili-crash:858
msgid "Quit"
msgstr "Sair"

#: bin/lili-crash:938 bin/lili-crash:941 bin/lili-crash:944 bin/lili-crash:947
#, python-brace-format
msgid "Diagnosis: {name}"
msgstr "Diagnóstico: {name}"

#: bin/lili-crash:951
#, python-brace-format
msgid "Diagnosis: {count} programs"
msgstr "Diagnóstico: {count} programas"

#: bin/lili-crash:964
#, python-brace-format
msgid "{agent} isn't installed: {url}"
msgstr "{agent} não está instalado: {url}"

#: bin/lili-crash:1068
msgid "Installing OpenCode"
msgstr "Instalando o OpenCode"

#: bin/lili-crash:1070
msgid "OpenCode didn't install; see the messages above."
msgstr "O OpenCode não foi instalado; veja as mensagens acima."

#: bin/lili-crash:1074
#, python-brace-format
msgid ""
"No Ollama answering at {url}. Start it there, or set the address back to "
"http://localhost:11434 to run it on this computer."
msgstr ""
"Nenhum Ollama respondendo em {url}. Inicie-o lá, ou volte o endereço para "
"http://localhost:11434 para rodar neste computador."

#: bin/lili-crash:1078
msgid ""
"Installing Ollama in your home folder (about 2 GB, it brings its own GPU "
"libraries)"
msgstr ""
"Instalando o Ollama na sua pasta pessoal (cerca de 2 GB, ele traz as "
"próprias bibliotecas de GPU)"

#: bin/lili-crash:1082
msgid ""
"Ollama comes as a .tar.zst file; install your distribution's zstd package "
"and try again."
msgstr ""
"O Ollama vem num arquivo .tar.zst; instale o pacote zstd da sua distribuição "
"e tente de novo."

#: bin/lili-crash:1085
msgid "Ollama didn't download; see the messages above."
msgstr "O Ollama não foi baixado; veja as mensagens acima."

#: bin/lili-crash:1087
msgid "Starting Ollama as a service of your user"
msgstr "Iniciando o Ollama como serviço do seu usuário"

#: bin/lili-crash:1097
msgid "Ollama didn't start: journalctl --user -u lili-ollama"
msgstr "O Ollama não iniciou: journalctl --user -u lili-ollama"

#: bin/lili-crash:1102
#, python-brace-format
msgid "Downloading {model}; this happens once"
msgstr "Baixando o {model}; isso acontece uma vez só"

#: bin/lili-crash:1116
#, python-brace-format
msgid "Giving the model room to read logs ({size}k tokens)"
msgstr "Dando ao modelo espaço para ler os logs ({size}k tokens)"

#: bin/lili-crash:1120
msgid "Ollama couldn't prepare the model."
msgstr "O Ollama não conseguiu preparar o modelo."

#: bin/lili-crash:1121
#, python-brace-format
msgid "The local AI is ready: {model} through Ollama at {url}."
msgstr "A IA local está pronta: {model} pelo Ollama em {url}."

#: bin/lili-crash:1125
#, python-brace-format
msgid "Unknown agent: {agent}"
msgstr "Agente desconhecido: {agent}"

#: bin/lili-crash:1126
msgid "Done. You can close this window."
msgstr "Pronto. Pode fechar esta janela."

#: bin/lili-crash:1127
#, python-brace-format
msgid "Installing {agent}"
msgstr "Instalando {agent}"

#: bin/lili-crash:1280
#, python-brace-format
msgid "No supported terminal found: {terminals}"
msgstr "Nenhum terminal compatível encontrado: {terminals}"

#: bin/lili-crash:1299
#, python-brace-format
msgid "Unknown setting: {key}. Use one of: {keys}"
msgstr "Configuração desconhecida: {key}. Use uma destas: {keys}"

#: bin/lili-crash:1359
#, python-brace-format
msgid "skill: linked for {agent}"
msgstr "skill: ligado para o {agent}"

#: bin/lili-crash:1364
msgid "service: running, and it starts with every login"
msgstr "serviço: rodando, e ele inicia a cada login"

#: bin/lili-crash:1366
msgid ""
"service: couldn't start it; try: systemctl --user enable --now lili-crash"
msgstr ""
"serviço: não consegui iniciar; tente: systemctl --user enable --now lili-"
"crash"

#: bin/lili-crash:1385
msgid "tray: Lili is next to the clock"
msgstr "bandeja: a Lili está ao lado do relógio"

#: bin/lili-crash:1387
msgid ""
"tray: right-click the system tray, choose Configure System Tray, open "
"Entries and set Lili Crash to Always show"
msgstr ""
"bandeja: clique com o botão direito na bandeja do sistema, escolha "
"Configurar, abra Entradas e ponha o Lili Crash em Sempre mostrar"

#: bin/lili-crash:1425
msgid ""
"tray: the tray icon needs AppIndicator (gir1.2-ayatanaappindicator3-0.1); "
"notifications work without it"
msgstr "bandeja: o ícone da bandeja precisa do AppIndicator (gir1.2-ayatanaappindicator3-0.1); as notificações funcionam sem ele"

#: bin/lili-crash:1430
msgid "tray: Lili is in the system tray, and she starts with every login"
msgstr "bandeja: a Lili está na bandeja do sistema, e ela inicia a cada login"

msgid "No preventive warning recorded for {id}"
msgstr "Nenhum alerta preventivo registrado para {id}"

msgid "Save incident report…"
msgstr "Salvar relatório de incidentes…"

msgid "Pause preventive monitoring"
msgstr "Pausar monitoramento preventivo"

msgid "Enable preventive monitoring"
msgstr "Ativar monitoramento preventivo"

msgid "Privacy: this AI may send logs and command output off this computer."
msgstr "Privacidade: esta IA pode enviar logs e resultados de comandos para fora deste computador."

msgid "Type SEND to continue, or press Enter to cancel: "
msgstr "Digite SEND para continuar ou pressione Enter para cancelar: "

msgid "This session uses {destination}. Logs and command output read by this AI may leave this computer and contain passwords, tokens or private documents.\n\nLili masks common secrets in the initial context only. It cannot filter additional output read by the agent or guarantee that all sensitive data is removed.\n\nUse Ollama on localhost to keep the diagnosis on this computer. Continue with this session?"
msgstr "Esta sessão usa {destination}. Os logs e resultados de comandos lidos por esta IA podem sair deste computador e conter senhas, tokens ou documentos privados.\n\nA Lili oculta segredos comuns apenas no contexto inicial. Ela não consegue filtrar os resultados adicionais lidos pelo agente nem garantir que todos os dados sigilosos foram removidos.\n\nUse o Ollama em localhost para manter o diagnóstico neste computador. Deseja continuar com esta sessão?"

msgid "Save incident report (metadata only, no raw logs)"
msgstr "Salvar relatório de incidentes (somente metadados, sem logs brutos)"

msgid "Incident report saved"
msgstr "Relatório de incidentes salvo"

msgid "Could not save incident report"
msgstr "Não foi possível salvar o relatório de incidentes"

msgid "Disk space is running low"
msgstr "O espaço em disco está acabando"

msgid "Free space or move files before writes and updates fail."
msgstr "Libere espaço ou mova arquivos antes que gravações e atualizações falhem."

msgid "The filesystem is running out of file entries"
msgstr "O sistema de arquivos está ficando sem inodes"

msgid "Inspect directories with many small files before creating more files."
msgstr "Verifique pastas com muitos arquivos pequenos antes de criar mais arquivos."

msgid "The disk may fill within 24 hours"
msgstr "O disco pode ficar cheio em até 24 horas"

msgid "Check growing logs and downloads; the estimate assumes the recent growth continues."
msgstr "Verifique logs e downloads em crescimento; a estimativa pressupõe que o ritmo recente continue."

msgid "Memory pressure is persisting"
msgstr "A pressão de memória está persistindo"

msgid "Save your work and inspect memory usage before opening more applications."
msgstr "Salve seu trabalho e verifique o uso de memória antes de abrir mais aplicativos."

msgid "Storage errors are recurring"
msgstr "Erros de armazenamento estão se repetindo"

msgid "Back up important files and inspect disk health and connections."
msgstr "Faça backup dos arquivos importantes e verifique a saúde e as conexões do disco."

msgid "Graphics driver timeouts are recurring"
msgstr "O driver gráfico está demorando a responder repetidamente"

msgid "Save your work and inspect driver errors before another graphics failure."
msgstr "Salve seu trabalho e verifique os erros do driver antes de outra falha gráfica."

msgid "Hardware errors are recurring"
msgstr "Erros de hardware estão se repetindo"

msgid "Inspect hardware health; corrected errors can precede an uncorrectable failure."
msgstr "Verifique a saúde do hardware; erros corrigidos podem anteceder uma falha irrecuperável."
