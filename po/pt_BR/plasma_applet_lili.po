#: plasma/lili/contents/ui/configGeneral.qml:207
msgid ""
"Your copy is kept in ~/.config/lili/skills, so updates never overwrite it."
msgstr ""
"Sua cópia fica em ~/.config/lili/skills, e as atualizações nunca a "
"sobrescrevem."

#: plasma/lili/contents/ui/configGeneral.qml:212
msgid "Restore default"
