#: plasma/lili/contents/ui/configGeneral.qml:240
msgid "Lili speaks your system's language."
msgstr "A Lili fala o idioma do seu sistema."

#: plasma/lili/contents/ui/configSupport.qml:35
msgid "EVM networks"
msgstr "Redes EVM"

#: plasma/lili/contents/ui/configSupport.qml:51
msgid ""
"Lili Crash is free and stays free. If she saved you an evening of digging "
"through logs, a donation keeps her going."
msgstr ""
"O Lili Crash é gratuito e vai continuar assim. Se ela te poupou uma noite "
"vasculhando logs, uma doação ajuda a mantê-la."

