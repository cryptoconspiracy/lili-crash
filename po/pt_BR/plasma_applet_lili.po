#: plasma/lili/contents/ui/configGeneral.qml:144
msgid "Type a model name the agent accepts, or leave it on the default."
msgstr "Digite o nome de um modelo que o agente aceite, ou deixe no padrão."

#: plasma/lili/contents/ui/configGeneral.qml:161
msgid "installed"
msgstr "instalado"

#: plasma/lili/contents/ui/configGeneral.qml:168
msgid "Install"
msgstr "Instalar"

#: plasma/lili/contents/ui/configGeneral.qml:171
msgid ""
"Runs the official installer in a terminal, in your home folder, without sudo."
msgstr ""
"Roda o instalador oficial num terminal, na sua pasta pessoal, sem sudo."

#: plasma/lili/contents/ui/configGeneral.qml:178
msgid "Ollama server:"
msgstr "Servidor do Ollama:"

#: plasma/lili/contents/ui/configGeneral.qml:184
msgid ""
"Leave it on localhost and Install sets Ollama up on this computer. Point it "
"at your own server to run the model there. Either way, nothing goes to an AI "
"company."
msgstr "Deixe em localhost e o Instalar prepara o Ollama neste computador. Aponte para o seu próprio servidor para rodar o modelo lá. Nos dois casos, nada vai para uma empresa de IA."

#: plasma/lili/contents/ui/configGeneral.qml:189
msgid "Diagnosis skill"
msgstr "Skill de diagnóstico"

