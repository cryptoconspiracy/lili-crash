#!/usr/bin/python3
"""Crash notifications, history and diagnosis on top of systemd-coredump and the journal.

  lili-crash list                       programs that crashed, newest first, as JSON
  lili-crash mark <binary> <state> [summary]
  lili-crash notify <pid|boot|steam-id> desktop notification for one crash, freeze or Steam game that closed early
  lili-crash watch                      notify every new crash, a Steam game that closes within 2 minutes,
                                        and a freeze from the last boot (run by the lili-crash service)
  lili-crash open                       Lili's window: usage and crash history
  lili-crash diagnose <pid|boot|steam-id>...  open Claude in a terminal to find out why
  lili-crash config [set <key> <value>] settings shared with the tray widget
  lili-crash install <agent>            run the agent's official installer in a terminal
  lili-crash skill <path|view|edit|reset>  this distro's notes for the diagnosis skill

A state (new, diagnosed, resolved, ignored) covers the crashes up to the moment it
was saved. If the program crashes again afterwards, it is new again.
"""

import configparser
import gettext
import json
import locale
import os
import re
import shlex
import shutil
import subprocess
import sys
import tempfile
import threading
import time
from datetime import date, datetime, timedelta
from pathlib import Path

LOCALEDIR = Path(__file__).resolve().parent.parent / "locale"
try:
    # Same rule as the rest of the desktop: glibc ignores LANGUAGE when the
    # configured locale isn't generated, so KDE stays in English, and so do we.
    locale.setlocale(locale.LC_MESSAGES, "")
    _ = gettext.translation("lili", LOCALEDIR if LOCALEDIR.is_dir() else None, fallback=True).gettext
except locale.Error:
    _ = gettext.NullTranslations().gettext

COREDUMP_MESSAGE_ID = "fc2e22bc6ee647b6b90729ab34a250b1"
STATE_DIR = Path(os.environ.get("XDG_STATE_HOME") or Path.home() / ".local/state") / "lili"
STATE_FILE = STATE_DIR / "state.json"
STATES = ("new", "diagnosed", "resolved", "ignored")
CONFIG_FILE = Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config") / "lili" / "config.json"


def reason(signal):
    return {
        "SIGSEGV": _("Touched memory it didn't own"),
        "SIGABRT": _("Gave up on an internal error"),
        "SIGBUS": _("Read memory that was no longer there"),
        "SIGFPE": _("Hit a math error, like dividing by zero"),
        "SIGILL": _("Tried to run an invalid instruction"),
        "SIGTRAP": _("Stopped at a debugger trap"),
        "SIGSYS": _("Made a forbidden system call"),
    }.get(signal) or _("Got signal {signal}").format(signal=signal)


def when(ts):
    moment = datetime.fromtimestamp(ts)
    hour = moment.strftime("%H:%M")
    if moment.date() == date.today():
        return _("today at {time}").format(time=hour)
    if moment.date() == date.today() - timedelta(days=1):
        return _("yesterday at {time}").format(time=hour)
    # Translators: strftime format for day and month, without the year.
    return _("on {date} at {time}").format(date=moment.strftime(_("%m/%d")), time=hour)


def data_dirs():
    dirs = [os.environ.get("XDG_DATA_HOME") or str(Path.home() / ".local/share"),
            str(Path.home() / ".local/share/flatpak/exports/share"), "/var/lib/flatpak/exports/share"]
    dirs += (os.environ.get("XDG_DATA_DIRS") or "").split(":") + ["/usr/local/share", "/usr/share"]
    return list(dict.fromkeys(d for d in dirs if d))


def read_desktop(path):
    parser = configparser.RawConfigParser(strict=False, interpolation=None)
    parser.optionxform = str
    try:
        parser.read(path, encoding="utf-8")
        return parser["Desktop Entry"]
    except (configparser.Error, KeyError, UnicodeDecodeError):
        return None


def desktop_by_id(app_id):
    for d in data_dirs():
        path = Path(d) / "applications" / f"{app_id}.desktop"
        if path.is_file():
            return read_desktop(path)
    return None


def desktop_by_exec(base):
    pattern = re.compile(rf"^([^ ]*/)?{re.escape(base)}( |$)")
    for d in data_dirs():
        for path in sorted((Path(d) / "applications").glob("*.desktop")):
            entry = read_desktop(path)
            if entry and pattern.match(entry.get("Exec", "")):
                return entry
    return None


def localized(entry, key):
    langs = (os.environ.get("LANGUAGE") or os.environ.get("LANG") or "").split(":")
    for lang in langs:
        lang = lang.split(".")[0]
        for variant in (lang, lang.split("_")[0]):
            if variant and entry.get(f"{key}[{variant}]"):
                return entry[f"{key}[{variant}]"]
    return entry.get(key)


def identity(comm, exe, unit):
    base = os.path.basename(exe) if exe else comm
    entry = None
    match = re.match(r"^app-flatpak-(.+)-\d+\.scope$", unit or "")
    if match:
        entry = desktop_by_id(match.group(1))
    else:
        # Anything started from a terminal lands in the terminal's scope, so the
        # scope only counts when the .desktop actually runs this binary.
        match = re.match(r"^app-(.+?)(@[^.]*\.service|-\d+\.scope)$", unit or "")
        if match:
            entry = desktop_by_id(match.group(1))
            if entry and base not in entry.get("Exec", ""):
                entry = None
    entry = entry or desktop_by_exec(base)
    if not entry:
        return comm or base, "application-x-executable"
    return localized(entry, "Name") or comm, entry.get("Icon") or "application-x-executable"


def crashes():
    fields = "COREDUMP_COMM,COREDUMP_EXE,COREDUMP_PID,COREDUMP_SIGNAL_NAME,COREDUMP_USER_UNIT,COREDUMP_TIMESTAMP,COREDUMP_UID"
    out = subprocess.run(["journalctl", "-o", "json", "--no-pager", f"--output-fields={fields}",
                          f"MESSAGE_ID={COREDUMP_MESSAGE_ID}"], capture_output=True, text=True).stdout
    for line in out.splitlines():
        try:
            e = json.loads(line)
            if e.get("COREDUMP_UID") != str(os.getuid()):
                continue
            yield {
                "pid": int(e["COREDUMP_PID"]),
                "comm": e.get("COREDUMP_COMM") or "",
                "exe": e.get("COREDUMP_EXE") or "",
                "signal": e.get("COREDUMP_SIGNAL_NAME") or "",
                "unit": e.get("COREDUMP_USER_UNIT") or "",
                "time": int(e.get("COREDUMP_TIMESTAMP") or e["__REALTIME_TIMESTAMP"]) // 1_000_000,
            }
        except (ValueError, KeyError, TypeError):
            continue


# logind says this whenever the system is asked to reboot or power off. A past boot
# without it ended some other way: the power button held down, a hard reset, a dead
# battery.
SHUTDOWN_MESSAGE_ID = "98268866d1d54a499c4e98921d93bc40"
FREEZE_KEY = "freeze"
BOOTS_FILE = STATE_DIR / "boots.json"
# Only the last stretch of a boot matters: drivers log harmless errors at startup,
# and a freeze always starts close to the end.
FREEZE_WINDOW = 30 * 60
FREEZE_SIGNS = [
    ("gpu", "nvidia", re.compile(r"NVRM: (Xid|GPU\d.*(fail|timeout|Timeout|stuck))|[Pp]age ?flip.*timed out|nvidia-modeset: ERROR")),
    ("gpu", "amdgpu", re.compile(r"amdgpu.*(ring \S+ timeout|GPU reset|GPU recovery|page fault)")),
    ("gpu", "i915", re.compile(r"i915.*(GPU HANG|[Rr]esetting)")),
    ("gpu", "xe", re.compile(r"\bxe\b.*(GPU hang|[Tt]imedout job|[Rr]eset)")),
    ("panic", "panic", re.compile(r"Kernel panic|Oops:|BUG: unable to handle")),
    ("lockup", "soft lockup", re.compile(r"soft lockup|hard LOCKUP|rcu.*detected stalls|blocked for more than \d+ seconds")),
    ("oom", "OOM", re.compile(r"Out of memory: Killed process")),
]


def freeze_reason(kind, tag):
    return {
        "gpu": _("The graphics driver ({driver}) stopped responding").format(driver=tag),
        "panic": _("The kernel crashed"),
        "lockup": _("The kernel got stuck"),
        "oom": _("It ran out of memory"),
    }.get(kind) or _("Nothing was logged before it stopped")


def journal(*args):
    return subprocess.run(["journalctl", "--no-pager", *args], capture_output=True, text=True).stdout


def inspect_boot(boot, last):
    """Returns how a past boot froze, or None if it shut down properly."""
    if journal("-b", boot, "-o", "cat", f"MESSAGE_ID={SHUTDOWN_MESSAGE_ID}").strip():
        return None
    freeze = {"boot": boot, "time": last, "kind": "unknown", "tag": "", "lines": []}
    shapes = set()
    out = journal("-b", boot, f"--since=@{last - FREEZE_WINDOW}", "-o", "json",
                  "--output-fields=MESSAGE,SYSLOG_IDENTIFIER")
    for line in out.splitlines():
        try:
            e = json.loads(line)
            message = e["MESSAGE"] if isinstance(e["MESSAGE"], str) else ""
        except (ValueError, KeyError):
            continue
        for kind, tag, pattern in FREEZE_SIGNS:
            if pattern.search(message):
                # The first sign is the cause; what follows is usually the fallout.
                if freeze["kind"] == "unknown":
                    freeze.update(kind=kind, tag=tag, time=int(e["__REALTIME_TIMESTAMP"]) // 1_000_000)
                seen = f"{e.get('SYSLOG_IDENTIFIER', '')}: {message[:300]}"
                # Hangs repeat the same complaint every few seconds; numbers aside, once is enough.
                shape = re.sub(r"\d+", "#", seen)
                if len(freeze["lines"]) < 6 and shape not in shapes:
                    shapes.add(shape)
                    freeze["lines"].append(seen)
                break
    return freeze


def load_boots():
    try:
        return json.loads(BOOTS_FILE.read_text())
    except (OSError, ValueError):
        return {}


def save_boots(boots):
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    tmp = BOOTS_FILE.with_suffix(".tmp")
    tmp.write_text(json.dumps(boots, ensure_ascii=False, indent=1))
    tmp.replace(BOOTS_FILE)


def freezes():
    """Past boots that ended without a shutdown. A finished boot's journal doesn't
    change, so each one is read once and remembered."""
    try:
        listed = json.loads(journal("--list-boots", "-o", "json"))
    except ValueError:
        return []
    known = load_boots()
    changed = False
    for b in listed:
        if b["index"] == 0 or b["boot_id"] in known:
            continue
        known[b["boot_id"]] = {"freeze": inspect_boot(b["boot_id"], b["last_entry"] // 1_000_000)}
        changed = True
    if changed:
        save_boots(known)
    present = {b["boot_id"] for b in listed}
    return [v["freeze"] for k, v in known.items() if k in present and v.get("freeze")]


# A game that closes on its own right after starting leaves no core dump: Proton or
# the game gives up and exits cleanly, often after a message box. Steam's own logs
# are the only record, so a short run is the sign.
EARLY_EXIT = 120
STEAM_ROOTS = [Path.home() / ".local/share/Steam", Path.home() / ".steam/steam",
               Path.home() / ".var/app/com.valvesoftware.Steam/.local/share/Steam"]
STEAM_LINE = re.compile(r"^\[(\d{4}-\d\d-\d\d \d\d:\d\d:\d\d)\] (.*)")
STEAM_STATE = re.compile(r"AppID (\d+) state changed : (.*)")
# Noise every Proton launch prints: Steam preloads both overlay builds and one always misses.
STEAM_NOISE = re.compile(r"gameoverlayrenderer\.so.*wrong ELF class|ThreadGetProcessExitCode|Shader update|"
                         r"breakpad exception handler")
STEAM_TROUBLE = re.compile(r"\b(err|errors?|fail(ed|ure)?|fatal|exception|crash(ed)?|abort(ed)?|timed out|timeout|"
                           r"Logged Off|disconnect(ed)?)\b", re.I)


def steam_root():
    return next((r for r in STEAM_ROOTS if (r / "logs/content_log.txt").is_file()), None)


def steam_time(stamp):
    return int(datetime.strptime(stamp, "%Y-%m-%d %H:%M:%S").timestamp())


def steam_lines(root, name):
    # Steam starts a fresh log once it grows, keeping the old one as .previous.
    for path in (root / f"logs/{name}.previous.txt", root / f"logs/{name}.txt"):
        try:
            with open(path, errors="replace") as f:
                for line in f:
                    match = STEAM_LINE.match(line.rstrip("\n"))
                    if match:
                        yield steam_time(match.group(1)), match.group(2)
        except OSError:
            continue


class SteamRuns:
    """Pairs 'App Running' with the state change that clears it, line by line."""

    def __init__(self):
        self.started = {}

    def feed(self, ts, text):
        match = STEAM_STATE.match(text)
        if not match:
            return None
        appid, running = match.group(1), "App Running" in match.group(2)
        if running:
            self.started.setdefault(appid, ts)
        elif appid in self.started:
            start = self.started.pop(appid)
            return {"appid": appid, "start": start, "time": ts, "seconds": ts - start}
        return None


def steam_game(root, appid):
    libraries = [root]
    try:
        libraries += [Path(p) for p in re.findall(r'"path"\s+"([^"]+)"', (root / "steamapps/libraryfolders.vdf").read_text())]
    except OSError:
        pass
    for library in dict.fromkeys(libraries):
        try:
            name = re.search(r'"name"\s+"([^"]+)"', (library / f"steamapps/appmanifest_{appid}.acf").read_text())
        except OSError:
            continue
        if name:
            return name.group(1)
    return f"AppID {appid}"


def steam_icon(appid):
    # Steam drops one of these for every game with a desktop shortcut.
    for d in data_dirs():
        if list(Path(d).glob(f"icons/hicolor/*/apps/steam_icon_{appid}.png")):
            return f"steam_icon_{appid}"
    return "steam"


def early_exits():
    root = steam_root()
    if not root:
        return []
    runs, found = SteamRuns(), []
    for ts, text in steam_lines(root, "content_log"):
        run = runs.feed(ts, text)
        if run and run["seconds"] < EARLY_EXIT:
            found.append(run)
    return found


def steam_id(run):
    return f"steam-{run['appid']}-{run['start']}"


def is_steam(target):
    return bool(re.fullmatch(r"steam-\d+-\d+", target))


def find_early_exit(target):
    for run in early_exits():
        if steam_id(run) == target:
            return run
    sys.exit(_("No early exit recorded for {id}").format(id=target))


def steam_evidence(root, run):
    """What Steam logged while the game ran: how it was launched, and what went wrong."""
    command, trouble, shapes = "", [], set()
    for log in ("console_log", "console-linux", "connection_log"):
        for ts, text in steam_lines(root, log):
            if not run["start"] - 2 <= ts <= run["time"] + 5:
                continue
            if not command and f"Game process added : AppID {run['appid']} " in text:
                command = text.split('"', 1)[-1].rstrip('"')
            elif STEAM_TROUBLE.search(text) and not STEAM_NOISE.search(text):
                shape = re.sub(r"\d+", "#", text)
                if len(trouble) < 12 and shape not in shapes:
                    shapes.add(shape)
                    trouble.append(f"{log}: {text[:300]}")
    tool = re.search(r"common/([^/']+)'?/proton ", command)
    return (tool.group(1) if tool else ""), command, trouble


def load_state():
    try:
        return json.loads(STATE_FILE.read_text())
    except (OSError, ValueError):
        return {}


def mark(exe, state, summary=""):
    if state not in STATES:
        sys.exit(_("Unknown state: {state}. Use one of: {states}").format(state=state, states=", ".join(STATES)))
    saved = load_state()
    # Resolving or ignoring keeps the summary the diagnosis wrote.
    saved[exe] = {"state": state, "until": int(time.time()), "summary": summary or saved.get(exe, {}).get("summary", "")}
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    tmp = STATE_FILE.with_suffix(".tmp")
    tmp.write_text(json.dumps(saved, ensure_ascii=False, indent=1))
    tmp.replace(STATE_FILE)


def programs():
    saved = load_state()
    grouped = {}
    for c in crashes():
        grouped.setdefault(c["exe"] or c["comm"], []).append(c)
    result = []
    for exe, items in grouped.items():
        items.sort(key=lambda c: c["time"])
        last = items[-1]
        name, icon = identity(last["comm"], last["exe"], last["unit"])
        state = saved.get(exe, {})
        fresh = [c for c in items if c["time"] > state.get("until", 0)]
        result.append({
            "exe": exe,
            "name": name,
            "icon": icon,
            "state": "new" if fresh else state.get("state", "new"),
            "summary": state.get("summary", ""),
            "count": len(items),
            "fresh": len(fresh),
            "last": {**last, "id": str(last["pid"]), "reason": reason(last["signal"]), "when": when(last["time"])},
            "crashes": items,
        })
    frozen = sorted(freezes(), key=lambda f: f["time"])
    if frozen:
        state = saved.get(FREEZE_KEY, {})
        fresh = [f for f in frozen if f["time"] > state.get("until", 0)]
        last = frozen[-1]
        result.append({
            "exe": FREEZE_KEY,
            "name": _("The computer froze"),
            "icon": "computer",
            "state": "new" if fresh else state.get("state", "new"),
            "summary": state.get("summary", ""),
            "count": len(frozen),
            "fresh": len(fresh),
            "last": {"id": last["boot"], "signal": last["tag"] or _("no log"), "time": last["time"],
                     "reason": freeze_reason(last["kind"], last["tag"]), "when": when(last["time"])},
            "crashes": frozen,
        })
    games = {}
    for run in early_exits():
        games.setdefault(run["appid"], []).append(run)
    root = steam_root()
    for appid, runs in games.items():
        key = f"steam:{appid}"
        state = saved.get(key, {})
        fresh = [r for r in runs if r["time"] > state.get("until", 0)]
        last = runs[-1]
        tool, _command, _trouble = steam_evidence(root, last)
        result.append({
            "exe": key,
            "name": steam_game(root, appid),
            "icon": steam_icon(appid),
            "state": "new" if fresh else state.get("state", "new"),
            "summary": state.get("summary", ""),
            "count": len(runs),
            "fresh": len(fresh),
            "last": {"id": steam_id(last), "signal": tool or "Steam", "time": last["time"],
                     "reason": early_exit_reason(last["seconds"]), "when": when(last["time"])},
            "crashes": runs,
        })
    return sorted(result, key=lambda p: p["last"]["time"], reverse=True)


def early_exit_reason(seconds):
    return _("Closed by itself {seconds} seconds after starting").format(seconds=seconds)


def find(pid):
    for p in programs():
        for c in p["crashes"]:
            if c.get("pid") == pid:
                return p, c
    sys.exit(_("No core dump with PID {pid}").format(pid=pid))


def find_freeze(boot):
    for f in freezes():
        if f["boot"] == boot:
            return f
    sys.exit(_("No freeze recorded for boot {boot}").format(boot=boot))


def notify(target):
    if is_boot(target):
        freeze = find_freeze(target)
        icon, title = "computer", _("The computer froze")
        text = _("{reason}, {when}. It had to be forced off.").format(
            reason=freeze_reason(freeze["kind"], freeze["tag"]), when=when(freeze["time"]))
    elif is_steam(target):
        run = find_early_exit(target)
        root = steam_root()
        tool, _command, _trouble = steam_evidence(root, run)
        icon, title = steam_icon(run["appid"]), _("{name} closed by itself").format(name=steam_game(root, run["appid"]))
        text = _("{reason}, {when}.").format(reason=early_exit_reason(run["seconds"]), when=when(run["time"]))
        if tool:
            text += " " + _("It ran with {tool}.").format(tool=tool)
    else:
        program, crash = find(int(target))
        icon, title = program["icon"], _("{name} crashed").format(name=program["name"])
        text = _("{reason} ({signal}), {when}.").format(reason=reason(crash["signal"]), signal=crash["signal"],
                                                        when=when(crash["time"]))
    # The configured locale may not be generated, and notify-send then refuses
    # anything that isn't ASCII.
    env = {**os.environ, "LC_ALL": "C.UTF-8"}
    button = _("Find out why")
    # "default" is a click on the notification body; Plasma doesn't draw it as a button.
    action = subprocess.run(
        ["notify-send", "--app-name=Lili Crash", f"--icon={icon}", "--hint=string:desktop-entry:lili-crash", "--hint=boolean:transient:true", "--urgency=normal", "--expire-time=0",
         f"--action=default={button}", f"--action=diagnose={button}", title, text],
        env=env, capture_output=True, text=True).stdout.strip()
    if action in ("default", "diagnose"):
        diagnose([target])


def is_boot(target):
    return bool(re.fullmatch(r"[0-9a-f]{32}", target))


def notify_last_freeze():
    """A freeze can't be announced while it happens (the screen is usually gone), so
    the next login tells about the boot before it, once."""
    found = freezes()
    boots = load_boots()
    frozen = [f for f in found if not boots[f["boot"]].get("notified")]
    if not frozen or load_state().get(FREEZE_KEY, {}).get("state") == "ignored":
        return
    for f in frozen:
        boots[f["boot"]]["notified"] = True
    save_boots(boots)
    last = max(frozen, key=lambda f: f["time"])
    # Only a freeze from the last day is news; older ones wait in the list.
    if time.time() - last["time"] < 86400:
        subprocess.Popen([sys.argv[0], "notify", last["boot"]], start_new_session=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def watch_steam(root):
    """Follows Steam's content log and notifies each game that closed too soon."""
    runs = SteamRuns()
    # -F keeps following when Steam rotates the log to content_log.previous.txt.
    follow = subprocess.Popen(["tail", "-F", "-n", "0", str(root / "logs/content_log.txt")],
                              stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True, errors="replace")
    for line in follow.stdout:
        match = STEAM_LINE.match(line.rstrip("\n"))
        run = match and runs.feed(steam_time(match.group(1)), match.group(2))
        if not run or run["seconds"] >= EARLY_EXIT:
            continue
        if load_state().get(f"steam:{run['appid']}", {}).get("state") == "ignored":
            continue
        subprocess.Popen([sys.argv[0], "notify", steam_id(run)], start_new_session=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def watch():
    """Follows the journal and notifies each new crash of this user's programs."""
    notify_last_freeze()
    root = steam_root()
    if root:
        threading.Thread(target=watch_steam, args=(root,), daemon=True).start()
    last_seen = {}
    follow = subprocess.Popen(["journalctl", "-f", "-n", "0", "-o", "json", "--output-fields=COREDUMP_PID,COREDUMP_EXE,"
                               "COREDUMP_COMM,COREDUMP_UID", f"MESSAGE_ID={COREDUMP_MESSAGE_ID}"],
                              stdout=subprocess.PIPE, text=True)
    for line in follow.stdout:
        try:
            e = json.loads(line)
            pid = int(e["COREDUMP_PID"])
        except (ValueError, KeyError, TypeError):
            continue
        if e.get("COREDUMP_UID") != str(os.getuid()):
            continue
        exe = e.get("COREDUMP_EXE") or e.get("COREDUMP_COMM") or ""
        if load_state().get(exe, {}).get("state") == "ignored":
            continue
        # A program stuck in a crash loop would otherwise bury the screen in toasts.
        if time.time() - last_seen.get(exe, 0) < 60:
            continue
        last_seen[exe] = time.time()
        subprocess.Popen([sys.argv[0], "notify", str(pid)], start_new_session=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def open_window():
    if shutil.which("plasmawindowed"):
        os.execvp("plasmawindowed", ["plasmawindowed", "lili"])
    # Without Plasma there's no panel to show, so the history goes to a terminal.
    open_terminal("Lili Crash", f"{shlex.quote(sys.argv[0])} list | python3 -m json.tool\n")


def user_language():
    for var in ("LANGUAGE", "LC_ALL", "LC_MESSAGES", "LANG"):
        value = os.environ.get(var, "").split(":")[0].split(".")[0]
        if value and value not in ("C", "POSIX"):
            return value
    return "en"


def diagnose(targets):
    facts, names, frozen = [], [], []
    for target in targets:
        if is_boot(target):
            f = find_freeze(target)
            stamp = datetime.fromtimestamp(f["time"]).strftime("%Y-%m-%d %H:%M:%S")
            seen = "\n".join(f"    {line}" for line in f["lines"]) or "    (nothing matched)"
            facts.append(f"- The whole computer froze and was forced off: boot {target}, around {stamp}, "
                         f"no shutdown recorded. First warning signs Lili matched in its last "
                         f"{FREEZE_WINDOW // 60} minutes (key '{FREEZE_KEY}'):\n{seen}")
            names.append(_("The computer froze"))
            frozen.append(target)
            continue
        if is_steam(target):
            run, root = find_early_exit(target), steam_root()
            name = steam_game(root, run["appid"])
            tool, command, trouble = steam_evidence(root, run)
            fmt = "%Y-%m-%d %H:%M:%S"
            seen = "\n".join(f"    {line}" for line in trouble) or "    (nothing matched)"
            facts.append(f"- Steam game {name} (AppID {run['appid']}) closed by itself {run['seconds']} seconds "
                         f"after starting, from {datetime.fromtimestamp(run['start']).strftime(fmt)} to "
                         f"{datetime.fromtimestamp(run['time']).strftime(fmt)}, with no core dump. "
                         f"Compatibility tool: {tool or 'none found (native, or the launch line was not logged)'}. "
                         f"Launch command: {command or 'not found'}. Steam's logs are in {root / 'logs'}; "
                         f"lines Lili matched in that window (key 'steam:{run['appid']}'):\n{seen}")
            names.append(name)
            continue
        program, crash = find(int(target))
        stamp = datetime.fromtimestamp(crash["time"]).strftime("%Y-%m-%d %H:%M:%S")
        facts.append(f"- {program['name']}: PID {target}, binary {program['exe']}, signal {crash['signal']}, "
                     f"{stamp}, {program['count']} crash(es) of this program in the journal")
        names.append(program["name"])

    where = f"{distro()[1]}, {os.environ.get('XDG_CURRENT_DESKTOP') or 'Linux desktop'}"
    if len(targets) == 1 and frozen:
        ask = f"This computer ({where}) froze and had to be forced off, and I'd like to know why."
        title = _("Diagnosis: {name}").format(name=names[0])
    elif len(targets) == 1 and is_steam(targets[0]):
        ask = f"A Steam game closed by itself right after starting on this machine ({where}), and I'd like to know why."
        title = _("Diagnosis: {name}").format(name=names[0])
    elif len(targets) == 1:
        ask = f"A program crashed on this machine ({where}) and I'd like to know why."
        title = _("Diagnosis: {name}").format(name=names[0])
    else:
        ask = (f"Several things crashed on this machine ({where}). Go through them one at a time, "
               "in order, and check whether they share a cause.")
        title = _("Diagnosis: {count} programs").format(count=len(targets))
    prompt = (f"{ask}\n\nWhat the journal recorded:\n" + "\n".join(facts) +
              f"\n\nUse the lili-diagnose-crash skill (if your tool has no skills, read {SKILL_FILE}), "
              f"and the notes for this distro in {notes_path()}. "
              "Don't change anything on the system; if there's a fix, propose it and ask before applying it. "
              f"Reply in the user's language ({user_language()}).")

    settings = load_config()
    agent = AGENTS.get(settings["agent"], AGENTS["claude"])
    binary = which(agent["command"])
    if not binary:
        sys.exit(_("{agent} isn't installed: {url}").format(agent=agent["name"], url=agent["url"]))
    model = settings.get(f"{settings['agent']}_model", "default")
    argv = [binary]
    if agent["model_flag"] and model != "default":
        argv += [agent["model_flag"], model]
    argv += agent["prompt"]

    STATE_DIR.mkdir(parents=True, exist_ok=True)
    fd, prompt_file = tempfile.mkstemp(dir=STATE_DIR, prefix="prompt-")
    with os.fdopen(fd, "w") as f:
        f.write(prompt)
    command = " ".join('"$prompt"' if a is PROMPT else shlex.quote(a) for a in argv)
    open_terminal(title, f"prompt=$(cat {shlex.quote(prompt_file)})\n"
                         f"rm -f {shlex.quote(prompt_file)}\n"
                         f"{command}\n")


def install(name):
    agent = AGENTS.get(name) or sys.exit(_("Unknown agent: {agent}").format(agent=name))
    done = _("Done. You can close this window.")
    open_terminal(_("Installing {agent}").format(agent=agent["name"]),
                  f"echo {shlex.quote('$ ' + agent['install'])}\n{agent['install']}\necho\necho {shlex.quote(done)}\n")


def open_terminal(title, script):
    settings = load_config()
    shell = shutil.which(settings["shell"]) or os.environ.get("SHELL") or "/bin/sh"
    # Agents won't remember trust for the whole home directory, so they run here.
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    # Terminals mangle command lines in their own ways (Konsole expands $VARS before
    # passing them on), so the terminal only ever gets "sh <file>" and the real work
    # happens in a script it can't reinterpret. The shell stays open afterwards.
    fd, launcher = tempfile.mkstemp(dir=STATE_DIR, prefix="launch-", suffix=".sh")
    with os.fdopen(fd, "w") as f:
        f.write(f"rm -f {shlex.quote(launcher)}\n{script}exec {shlex.quote(shell)} -i\n")
    argv = terminal_command(settings["terminal"], str(STATE_DIR), title, ["sh", launcher])
    # Started from inside another agent session, these would make the new agent
    # think it's that session's child (Claude Code then stops saving transcripts).
    env = {k: v for k, v in os.environ.items() if k not in SESSION_MARKERS}
    os.execvpe(argv[0], argv, env)


SESSION_MARKERS = {"CLAUDECODE", "CLAUDE_PID", "CLAUDE_EFFORT", "CLAUDE_AGENT_SDK_VERSION", "CLAUDE_CODE_CHILD_SESSION",
                   "CLAUDE_CODE_SESSION_ID", "CLAUDE_CODE_SESSION_ATTENDED", "CLAUDE_CODE_ENTRYPOINT",
                   "CLAUDE_CODE_EXECPATH", "CLAUDE_CODE_MESSAGING_SOCKET", "CLAUDE_CODE_MESSAGING_TOKEN",
                   "CLAUDE_CODE_ENABLE_TASKS", "CLAUDE_CODE_ENABLE_SDK_FILE_CHECKPOINTING", "CODEX_SANDBOX",
                   "CODEX_SANDBOX_NETWORK_DISABLED"}


PROMPT = object()

# How each agent opens an interactive session seeded with a prompt, without the
# flags that make it act without asking: diagnosis reads, the user decides.
AGENTS = {
    "claude": {"name": "Claude Code", "command": "claude", "model_flag": "--model", "prompt": ["--", PROMPT],
               "url": "https://code.claude.com", "install": "curl -fsSL https://claude.ai/install.sh | bash"},
    "codex": {"name": "Codex", "command": "codex", "model_flag": "-m", "prompt": ["--", PROMPT],
              "url": "https://github.com/openai/codex", "install": "curl -fsSL https://chatgpt.com/codex/install.sh | sh"},
    "opencode": {"name": "OpenCode", "command": "opencode", "model_flag": "-m", "prompt": ["--prompt", PROMPT],
                 "url": "https://opencode.ai", "install": "curl -fsSL https://opencode.ai/install | bash"},
    "gemini": {"name": "Gemini CLI", "command": "gemini", "model_flag": "-m", "prompt": ["-i", PROMPT],
               "url": "https://github.com/google-gemini/gemini-cli", "install": "npm install -g @google/gemini-cli"},
    "agy": {"name": "Antigravity CLI", "command": "agy", "model_flag": None, "prompt": ["--prompt-interactive", PROMPT],
            "url": "https://antigravity.google", "install": "curl -fsSL https://antigravity.google/cli/install.sh | bash"},
    "copilot": {"name": "GitHub Copilot CLI", "command": "copilot", "model_flag": "--model",
                "prompt": ["--interactive", PROMPT],
                "url": "https://github.com/github/copilot-cli", "install": "curl -fsSL https://gh.io/copilot-install | bash"},
    # A bare prompt naming a subcommand (update, login) would run it, so the agent subcommand is explicit.
    "cursor": {"name": "Cursor CLI", "command": "cursor-agent", "model_flag": "--model", "prompt": ["agent", "--", PROMPT],
               "url": "https://cursor.com/cli", "install": "curl -fsS https://cursor.com/install | bash"},
    "grok": {"name": "Grok CLI", "command": "grok", "model_flag": None, "prompt": ["--", PROMPT],
             "url": "https://x.ai/cli", "install": "curl -fsSL https://x.ai/cli/install.sh | bash"},
}
SKILL_FILE = Path(__file__).resolve().parent.parent / "skill" / "lili-diagnose-crash" / "SKILL.md"
DISTRO_NOTES = SKILL_FILE.parent / "distros"
USER_NOTES = CONFIG_FILE.parent / "skills"


def os_release():
    try:
        text = Path("/etc/os-release").read_text()
    except OSError:
        return {}
    return {k: v.strip('"') for k, _, v in (line.partition("=") for line in text.splitlines()) if v}


def distro():
    info = os_release()
    candidates = [info.get("ID", "")] + info.get("ID_LIKE", "").split()
    for candidate in candidates:
        key = "opensuse" if candidate.startswith("opensuse") else candidate
        # Bazzite, Silverblue and friends update as one image, not package by package.
        if key == "fedora" and Path("/run/ostree-booted").exists():
            key = "fedora-atomic"
        if key and (DISTRO_NOTES / f"{key}.md").is_file():
            return key, info.get("PRETTY_NAME") or info.get("NAME") or key
    return "generic", info.get("PRETTY_NAME") or "Linux"


def notes_path():
    key, _name = distro()
    edited = USER_NOTES / f"{key}.md"
    return edited if edited.is_file() else DISTRO_NOTES / f"{key}.md"


def skill(action):
    key, _name = distro()
    edited = USER_NOTES / f"{key}.md"
    if action == "path":
        print(notes_path())
    elif action == "view":
        # The default notes live in the install; hand out a read-only copy so a
        # "view" can't turn into an accidental edit of the shipped file.
        source = notes_path()
        if source != edited:
            fd, copy = tempfile.mkstemp(prefix=f"lili-{key}-", suffix=".md")
            with os.fdopen(fd, "w") as f:
                f.write(source.read_text())
            os.chmod(copy, 0o444)
            source = copy
        subprocess.Popen(["xdg-open", str(source)], start_new_session=True)
    elif action == "edit":
        if not edited.is_file():
            USER_NOTES.mkdir(parents=True, exist_ok=True)
            edited.write_text((DISTRO_NOTES / f"{key}.md").read_text())
        subprocess.Popen(["xdg-open", str(edited)], start_new_session=True)
    elif action == "reset":
        edited.unlink(missing_ok=True)
    else:
        sys.exit(__doc__.strip())


TERMINALS = {
    "konsole": lambda cwd, title, cmd: ["konsole", "--workdir", cwd, "-p", f"tabtitle={title}", "-e", *cmd],
    "kitty": lambda cwd, title, cmd: ["kitty", "--directory", cwd, "--title", title, *cmd],
    "alacritty": lambda cwd, title, cmd: ["alacritty", "--working-directory", cwd, "--title", title, "-e", *cmd],
    "wezterm": lambda cwd, title, cmd: ["wezterm", "start", "--cwd", cwd, "--", *cmd],
    "foot": lambda cwd, title, cmd: ["foot", f"--working-directory={cwd}", f"--title={title}", *cmd],
    "gnome-terminal": lambda cwd, title, cmd: ["gnome-terminal", f"--working-directory={cwd}", f"--title={title}", "--", *cmd],
}


def which(command):
    # Agent installers drop their binary in ~/.local/bin, which a systemd user
    # service doesn't have on PATH on every distro.
    return shutil.which(command, path=os.pathsep.join([os.environ.get("PATH", ""), str(Path.home() / ".local/bin")]))


def installed_terminals():
    return [t for t in TERMINALS if shutil.which(t)]


def terminal_command(choice, cwd, title, cmd):
    if choice == "auto" or not shutil.which(choice):
        preferred = os.path.basename(os.environ.get("TERMINAL", ""))
        desktop = os.environ.get("XDG_CURRENT_DESKTOP", "")
        order = [preferred, "konsole" if "KDE" in desktop else "gnome-terminal", *TERMINALS]
        choice = next((t for t in order if t in TERMINALS and shutil.which(t)), None)
        if not choice:
            sys.exit(_("No supported terminal found: {terminals}").format(terminals=", ".join(TERMINALS)))
    return TERMINALS[choice](cwd, title, cmd)


DEFAULTS = {"avatar": "lili2", "agent": "claude", "terminal": "auto", "shell": "fish",
            **{f"{a}_model": "default" for a, spec in AGENTS.items() if spec["model_flag"]}}


def load_config():
    try:
        saved = json.loads(CONFIG_FILE.read_text())
    except (OSError, ValueError):
        saved = {}
    return {**DEFAULTS, **{k: v for k, v in saved.items() if k in DEFAULTS and isinstance(v, str)}}


def set_config(key, value):
    if key not in DEFAULTS:
        sys.exit(_("Unknown setting: {key}. Use one of: {keys}").format(key=key, keys=", ".join(DEFAULTS)))
    settings = load_config()
    settings[key] = value
    CONFIG_FILE.parent.mkdir(parents=True, exist_ok=True)
    CONFIG_FILE.write_text(json.dumps(settings, indent=1))
    if key == "avatar":
        point_icon(value)


ICON_DIR = Path(os.environ.get("XDG_DATA_HOME") or Path.home() / ".local/share") / "icons/hicolor/128x128/apps"


def point_icon(avatar):
    # The themed icon follows the chosen avatar, so the taskbar, the widget list
    # and the notifications all show the same Lili.
    target = ICON_DIR / f"lili-crash-{avatar}.png"
    if not target.is_file():
        return
    link = ICON_DIR / "lili-crash.png"
    tmp = ICON_DIR / ".lili-crash.png.new"
    tmp.unlink(missing_ok=True)
    tmp.symlink_to(target.name)
    tmp.replace(link)
    ICON_DIR.parent.parent.touch()


def main(args):
    command, rest = (args[0], args[1:]) if args else ("", [])
    if command == "list" and not rest:
        found = programs()
        for p in found:
            p.pop("crashes")
        print(json.dumps({"programs": found, "pending": sum(p["state"] == "new" for p in found)}, ensure_ascii=False))
    elif command == "config" and not rest:
        key, name = distro()
        print(json.dumps({**load_config(), "terminals": installed_terminals(),
                          "agents": [{"id": a, "name": spec["name"], "installed": bool(which(spec["command"])),
                                      "models": bool(spec["model_flag"])} for a, spec in AGENTS.items()],
                          "distro": {"key": key, "name": name, "edited": (USER_NOTES / f"{key}.md").is_file()}}))
    elif command == "config" and len(rest) == 3 and rest[0] == "set":
        set_config(rest[1], rest[2])
    elif command == "mark" and len(rest) >= 2:
        mark(rest[0], rest[1], " ".join(rest[2:]))
    elif command == "notify" and len(rest) == 1 and (rest[0].isdigit() or is_boot(rest[0]) or is_steam(rest[0])):
        notify(rest[0])
    elif command == "open" and not rest:
        open_window()
    elif command == "watch" and not rest:
        watch()
    elif command == "skill" and len(rest) == 1:
        skill(rest[0])
    elif command == "install" and len(rest) == 1:
        install(rest[0])
    elif command == "diagnose" and rest and all(r.isdigit() or is_boot(r) or is_steam(r) for r in rest):
        diagnose(rest)
    else:
        sys.exit(__doc__.strip())


if __name__ == "__main__":
    main(sys.argv[1:])
